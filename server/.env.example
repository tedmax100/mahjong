# 麻將伺服器環境變數範本
# 複製此檔案為 .env 並填入實際值

# ============================================
# 遊戲伺服器設定 (cmd/main.go)
# ============================================

# Auth Proxy URL（用於驗證 JWT）
# 如果未設定，JWT 驗證功能將停用
AUTH_PROXY_URL=http://localhost:3001

# 與 Lobby 伺服器通訊的內部密鑰（必須與 Lobby 伺服器設定一致）
LOBBY_INTERNAL_SECRET=dev-internal-secret

# ============================================
# Lobby & Auth Proxy 伺服器設定 (cmd/lobby/main.go)
# ============================================

# 伺服器埠號
PORT=3001

# 與遊戲伺服器通訊的內部密鑰
LOBBY_INTERNAL_SECRET=dev-internal-secret

# 與外部自定義伺服器通訊的共享密鑰
EXTERNAL_SERVER_SECRET=dev-external-secret

# Google OAuth 設定
# 在 Google Cloud Console 取得：https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session 密鑰（請使用隨機字串）
# 可用 `openssl rand -hex 32` 或 `go run -e 'import "crypto/rand"; import "encoding/hex"; b := make([]byte, 32); rand.Read(b); println(hex.EncodeToString(b))'` 生成
SESSION_SECRET=change-this-to-a-random-string

# ============================================
# Google Console 設定說明
# ============================================
# 1. 前往 Google Cloud Console > APIs & Services > Credentials
# 2. 建立或編輯 OAuth 2.0 Client ID
# 3. 在「Authorized redirect URIs」新增：
#    - http://localhost:3001/auth/google/callback（本地開發）
#    - https://auth.your-domain.com/auth/google/callback（生產環境）
